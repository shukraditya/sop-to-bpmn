  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Start"/>
    <bpmn:task id="Task_1" name="Receive customer support email"/>
    <bpmn:exclusiveGateway id="Gateway_1" name="The issue is billing-related?"/>
    <bpmn:task id="Task_2" name="Assign to Billing Queue"/>
    <bpmn:task id="Task_3" name="Assign to General Support Queue"/>
    <bpmn:task id="Task_4" name="Send acknowledgment email to customer"/>
    <bpmn:task id="Task_5" name="Close the triage step"/>
    <bpmn:task id="Task_6" name="Notify the manager if available"/>
    <bpmn:task id="Task_7" name="Receive feedback"/>
    <bpmn:exclusiveGateway id="Gateway_2" name="To refund the customer?"/>
    <bpmn:task id="Task_8" name="Process the refund"/>
    <bpmn:task id="Task_9" name="Send a confirmation email"/>
    <bpmn:task id="Task_10" name="Archive the request"/>
    <bpmn:task id="Task_11" name="Close the case"/>
    <bpmn:task id="Task_12" name="Open the ticket dashboard"/>
    <bpmn:task id="Task_13" name="Filter by priority"/>
    <bpmn:task id="Task_14" name="Assign top item to on-call agent"/>
    <bpmn:endEvent id="EndEvent_1" name="End"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Gateway_1"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_1" targetRef="Task_2" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_1" targetRef="Task_3" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_2" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_3" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_4" targetRef="Task_5"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_5" targetRef="Task_6"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_6" targetRef="Task_7"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_7" targetRef="Gateway_2"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_2" targetRef="Task_8" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_8" targetRef="Task_9"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_2" targetRef="Task_10" name="No">
